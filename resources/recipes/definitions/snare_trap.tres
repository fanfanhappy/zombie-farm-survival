[gd_resource type="Resource" script_class="RecipeDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/recipe_definition.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/item_amount.gd" id="2_item"]

[sub_resource type="Resource" id="Ingredient_0"]
script = ExtResource("2_item")
item_id = &"wood"
amount = 2

[sub_resource type="Resource" id="Ingredient_1"]
script = ExtResource("2_item")
item_id = &"stone"
amount = 3

[sub_resource type="Resource" id="Result_0"]
script = ExtResource("2_item")
item_id = &"snare_trap"
amount = 1


[resource]
script = ExtResource("1_script")
recipe_id = &"snare_trap"
display_name = "简易捕兽夹"
station = "workbench"
ingredients = Array[ExtResource("2_item")]([SubResource("Ingredient_0"), SubResource("Ingredient_1")])
results = Array[ExtResource("2_item")]([SubResource("Result_0")])
